# Copy to .env. Placeholders only; never commit real values.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rag
LOG_LEVEL=INFO

# Backend (used when running outside docker compose)
DATABASE_URL=postgresql+asyncpg://rag:change-me-local-only@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# Frontend server-side URL of the API
API_URL=http://localhost:8000

# Ingestion (defaults are fine for local runs)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
STORAGE_DIR=./data/files

# Retrieval tunables (see backend/app/config.py for all)
RETRIEVAL_VECTOR_K=30
RETRIEVAL_KEYWORD_K=30
RRF_K=60
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=30
RERANK_TOP_N=6

# LLM provider (M3). Leave keys empty in git; set them in your local .env only.
APP_ENV=dev
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The stage-1 abstention threshold is tuned from eval results (`make tune-threshold`) and
# lives in backend/app/config.py; do not override it here.

# Offline test mode (no LLM, no API key): LLM_PROVIDER=extractive quotes the best-matching
# sentence. Used by `make e2e`. Refused when APP_ENV=prod.

# Evaluation (make eval). The judge is optional; leave unset to use string matching only.
# EVAL_JUDGE_PROVIDER=openai
# EVAL_JUDGE_MODEL=
EVAL_MAX_COST_USD=5

# --- Authentication (M6): Keycloak OIDC. LOCAL COMPOSE DEMO VALUES ONLY: replace every one in any
# real deployment. Demo users alice / bob / admin live in infra/keycloak/realm-northwind.json.
RAG_WEB_CLIENT_SECRET=change-me-local-client-secret
SESSION_SECRET=change-me-local-session-secret-32-chars-min
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
# Dev-header login (X-Dev-User) only exists when OIDC_ISSUER is unset, and never in prod.
# DEV_AUTH_ENABLED=false
