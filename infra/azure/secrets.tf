# ---------------------------------------------------------------------------------------
# Generated secrets. They live in Key Vault AND in Terraform state, so the state file is
# sensitive: use an encrypted, access-controlled remote backend for anything real.
# Alphabets are URL-safe on purpose (the DB password goes into a connection URL).
# ---------------------------------------------------------------------------------------
resource "random_password" "postgres" {
  length  = 32
  special = false # letters and digits only: nothing to URL-encode, no spaces
}

resource "random_password" "session" {
  length  = 48
  special = false
}

resource "random_password" "audit_hmac" {
  length  = 48
  special = false
}

resource "random_password" "redis" {
  length  = 32
  special = false
}

locals {
  postgres_admin = "ragadmin"
  postgres_db    = "rag"

  # asyncpg takes `ssl=` (not libpq's `sslmode=`). urlencode() is belt and braces.
  database_url = format(
    "postgresql+asyncpg://%s:%s@%s:5432/%s?ssl=require",
    local.postgres_admin,
    urlencode(random_password.postgres.result),
    azurerm_postgresql_flexible_server.main.fqdn,
    local.postgres_db,
  )
  redis_url_api = format("redis://:%s@%s:6379/0", urlencode(random_password.redis.result), local.redis_name)
  redis_url_web = format("redis://:%s@%s:6379/1", urlencode(random_password.redis.result), local.redis_name)

  # name => value. Container App secret names: lowercase letters, digits and '-'.
  key_vault_secrets = {
    "database-url"       = local.database_url
    "redis-url-api"      = local.redis_url_api
    "redis-url-web"      = local.redis_url_web
    "redis-password"     = random_password.redis.result
    "session-secret"     = random_password.session.result
    "audit-hmac-key"     = random_password.audit_hmac.result
    "oidc-client-secret" = var.oidc_client_secret
    "llm-api-key"        = var.llm_api_key
  }
  # for_each keys must not be sensitive; the names are fixed, only the values are secret.
  key_vault_secret_names = toset(keys(local.key_vault_secrets))
}

#trivy:ignore:AZU-0017 Secrets are generated by Terraform; rotation = replace the random_password, see README "Rotating secrets".
resource "azurerm_key_vault_secret" "app" {
  for_each     = local.key_vault_secret_names
  name         = each.key
  value        = local.key_vault_secrets[each.key]
  key_vault_id = azurerm_key_vault.main.id
  content_type = "text/plain"
  tags         = local.tags

  depends_on = [time_sleep.rbac_propagation]
}

#trivy:ignore:AZU-0017 Operator-supplied registry credential; rotated by the operator, see README "Rotating secrets".
resource "azurerm_key_vault_secret" "registry_password" {
  count        = var.registry_server != "" ? 1 : 0
  name         = "registry-password"
  value        = var.registry_password
  key_vault_id = azurerm_key_vault.main.id
  content_type = "text/plain"
  tags         = local.tags

  depends_on = [time_sleep.rbac_propagation]
}
